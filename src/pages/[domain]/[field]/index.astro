---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import FormulaCard from '../../../components/FormulaCard.astro';
import RichText from '../../../components/RichText.astro';
import { getLibrary } from '../../../lib/content';
import { href } from '../../../lib/url';

export function getStaticPaths() {
  return getLibrary().domains.flatMap((d) =>
    d.fields.map((fl) => ({ params: { domain: d.id, field: fl.id }, props: { path: fl.path } })),
  );
}

const lib = getLibrary();
const [d, fl] = Astro.props.path.split('/');
const domain = lib.domains.find((x) => x.id === d)!;
const field = domain.fields.find((x) => x.id === fl)!;
---

<Base title={field.name} description={field.description}>
  <PageHeader
    crumbs={[{ label: domain.name, path: domain.path }]}
    title={field.name}
    description={field.description}
    icon={field.icon}
    eyebrow={domain.name}
  />

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {
      field.topics.length > 1 && (
        <nav aria-label="Topics in this field" class="mt-8 flex flex-wrap gap-2 text-sm">
          {field.topics.map((t) => (
            <a
              href={`#${t.id}`}
              class="rounded-full border border-border px-3 py-1 text-muted transition-colors hover:border-accent hover:text-accent"
            >
              {t.name} <span class="tabular-nums opacity-70">{t.formulas.length}</span>
            </a>
          ))}
        </nav>
      )
    }

    {
      field.topics.map((t) => (
        <section id={t.id} aria-labelledby={`${t.id}-h`} class="mt-12 scroll-mt-20">
          <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-border pb-3">
            <div>
              <h2 id={`${t.id}-h`} class="text-xl font-semibold tracking-tight">
                <a href={href(t.path)} class="rounded hover:text-accent">
                  {t.name}
                </a>
              </h2>
              <p class="mt-1 text-sm text-muted">
                <RichText text={t.description} />
              </p>
            </div>
            <a href={href(t.path)} class="shrink-0 rounded text-sm text-accent hover:underline">
              Topic page<span class="sr-only">: {t.name}</span> →
            </a>
          </div>
          {t.formulas.length ? (
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {t.formulas.map((f) => (
                <FormulaCard formula={f} href={href(lib.formulaPath(f))} />
              ))}
            </div>
          ) : (
            <p class="text-sm italic text-muted">No formulas in this topic yet.</p>
          )}
        </section>
      ))
    }
  </div>
</Base>
