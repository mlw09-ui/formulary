---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---

<Base title="Page not found" description="This page does not exist.">
  <div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 text-muted">The formula or page you are looking for does not exist, or has moved.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={href()} class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-on-accent hover:bg-accent-hover">Go home</a>
      <button type="button" data-search-open class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-border-strong">Search</button>
    </div>
  </div>
</Base>
