---
import { href } from '../lib/url';

interface Props {
  /** Ancestors only; the current page is `current`. */
  items: Array<{ label: string; path: string }>;
  current: string;
}
const { items, current } = Astro.props;
const all = [{ label: 'Home', path: '' }, ...items];
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-muted">
    {
      all.map((item) => (
        <li class="flex items-center gap-1.5">
          <a href={href(item.path)} class="rounded hover:text-accent hover:underline">
            {item.label}
          </a>
          <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3 w-3 opacity-60" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="m6 3 5 5-5 5" />
          </svg>
        </li>
      ))
    }
    <li><span aria-current="page" class="text-text">{current}</span></li>
  </ol>
</nav>
