---
import { href } from '../lib/url';
const indexUrl = href('search-index.json');
---

<dialog
  id="search-dialog"
  data-index-url={indexUrl}
  aria-label="Search formulas"
  class="m-0 mx-auto mt-[10vh] w-[min(40rem,calc(100vw-2rem))] max-w-none rounded-xl border border-border bg-raised p-0 text-text shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-[2px]"
>
  <div class="flex items-center gap-3 border-b border-border px-4">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-muted" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <input
      id="search-input"
      type="search"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      placeholder="Formula, symbol (ρ, Re, ΔP) or topic…"
      class="h-14 w-full bg-transparent text-base outline-none placeholder:text-muted [&::-webkit-search-cancel-button]:hidden"
    />
    <kbd class="hidden rounded border border-border px-1.5 text-xs text-muted sm:inline">Esc</kbd>
  </div>
  <ul id="search-results" role="listbox" aria-label="Results" class="max-h-[60vh] overflow-y-auto p-2 empty:hidden"></ul>
  <p id="search-status" class="px-5 py-6 text-sm text-muted" aria-live="polite">
    Search by name, symbol, tag or description.
  </p>
  <div class="hidden items-center gap-4 border-t border-border px-4 py-2 text-xs text-muted sm:flex">
    <span><kbd class="font-sans">↑</kbd> <kbd class="font-sans">↓</kbd> to navigate</span>
    <span><kbd class="font-sans">↵</kbd> to open</span>
  </div>
</dialog>

<script>
  import Fuse, { type FuseResult } from 'fuse.js';
  import { compact, type SearchEntry } from '../lib/search';

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const status = document.getElementById('search-status') as HTMLParagraphElement;
  const DEFAULT_STATUS = status.textContent!.trim();

  let fuse: Fuse<SearchEntry> | undefined;
  let results: SearchEntry[] = [];
  let active = -1;

  async function load() {
    if (fuse) return;
    const res = await fetch(dialog.dataset.indexUrl!);
    const data = (await res.json()) as SearchEntry[];
    fuse = new Fuse(data, {
      keys: [
        { name: 'name', weight: 3 },
        { name: 'aliases', weight: 2.5 },
        { name: 'compact', weight: 2.5 },
        { name: 'symbols', weight: 1.5 },
        { name: 'tags', weight: 1.5 },
        { name: 'summary', weight: 1 },
        { name: 'path', weight: 0.6 },
      ],
      threshold: 0.34,
      includeScore: true,
      ignoreLocation: true,
      ignoreDiacritics: true,
      minMatchCharLength: 1,
    });
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    load().then(update).catch(() => (status.textContent = 'Search index failed to load.'));
  }

  function escape(s: string) {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  }

  function update() {
    const q = input.value.trim();
    // Fuse's combined score lets weak partial matches through (e.g. "rho" ≈ "roots").
    // Keep only results close to the best match.
    // Also search the compact form ("E=mc^2" → "e=mc2") and keep each formula's best score.
    const best0 = new Map<string, FuseResult<SearchEntry>>();
    if (q && fuse) {
      const cq = compact(q);
      for (const h of [...fuse.search(q, { limit: 20 }), ...(cq !== q ? fuse.search(cq, { limit: 20 }) : [])]) {
        const prev = best0.get(h.item.id);
        if (!prev || (h.score ?? 1) < (prev.score ?? 1)) best0.set(h.item.id, h);
      }
    }
    const hits = [...best0.values()].sort((x, y) => (x.score ?? 1) - (y.score ?? 1));
    const best = hits[0]?.score ?? 0;
    results = hits.filter((h) => (h.score ?? 1) <= Math.min(0.4, best + 0.25)).slice(0, 12).map((h) => h.item);
    active = results.length ? 0 : -1;
    list.innerHTML = results
      .map(
        (r, i) => `
        <li id="sr-${i}" role="option" aria-selected="${i === active}" data-index="${i}"
            class="cursor-pointer rounded-lg px-3 py-2.5 aria-selected:bg-accent-soft">
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-medium">${escape(r.name)}</span>
            <span class="shrink-0 text-xs capitalize text-muted">${r.difficulty}</span>
          </div>
          <div class="mt-0.5 text-xs text-muted">${escape(r.path)}</div>
          <div class="mt-1 line-clamp-1 text-sm text-muted">${escape(r.summary)}</div>
        </li>`,
      )
      .join('');
    input.setAttribute('aria-expanded', String(results.length > 0));
    syncActive();
    status.textContent = !q
      ? DEFAULT_STATUS
      : results.length
        ? `${results.length} result${results.length === 1 ? '' : 's'}`
        : `No formulas match “${q}”.`;
    status.classList.toggle('sr-only', results.length > 0);
  }

  function syncActive() {
    list.querySelectorAll('[role=option]').forEach((el, i) => el.setAttribute('aria-selected', String(i === active)));
    if (active >= 0) {
      input.setAttribute('aria-activedescendant', `sr-${active}`);
      document.getElementById(`sr-${active}`)?.scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  }

  function go(i: number) {
    const r = results[i];
    if (r) window.location.href = r.url;
  }

  input.addEventListener('input', update);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' && results.length) {
      e.preventDefault();
      active = (active + 1) % results.length;
      syncActive();
    } else if (e.key === 'ArrowUp' && results.length) {
      e.preventDefault();
      active = (active - 1 + results.length) % results.length;
      syncActive();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      go(active);
    }
  });
  list.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[data-index]');
    if (li) go(Number(li.dataset.index));
  });
  // Click on the backdrop closes the dialog.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, [contenteditable]');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    } else if (e.key === '/' && !typing && !dialog.open) {
      e.preventDefault();
      open();
    }
  });
</script>
