---
interface Props {
  level: 'basic' | 'intermediate' | 'advanced';
}
const { level } = Astro.props;
const bars = { basic: 1, intermediate: 2, advanced: 3 }[level];
const label = level[0]!.toUpperCase() + level.slice(1);
---

<span class="inline-flex items-center gap-1.5 rounded-full border border-border px-2 py-0.5 text-xs font-medium text-muted">
  <span aria-hidden="true" class="flex items-end gap-[2px]">
    {[1, 2, 3].map((i) => <span class:list={['w-[3px] rounded-sm', i <= bars ? 'bg-accent' : 'bg-border-strong']} style={`height:${4 + i * 2}px`} />)}
  </span>
  <span><span class="sr-only">Difficulty: </span>{label}</span>
</span>
