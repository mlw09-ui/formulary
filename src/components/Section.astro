---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section aria-labelledby={id} class="mt-14">
  <h2 id={id} class="mb-5 text-xl font-semibold tracking-tight">
    <a href={`#${id}`} class="group rounded">
      {title}
      <span aria-hidden="true" class="ml-1 text-muted opacity-0 transition-opacity group-hover:opacity-100">#</span>
    </a>
  </h2>
  <slot />
</section>
